---
import { SMOKE_WRITES_ENABLED } from "astro:env/server";
import Layout from "@/layouts/Layout.astro";
import { configStatuses } from "@/lib/config-status";
import { listCrags, listRoutes, type CatalogCrag, type CatalogRoute } from "@/lib/catalog";
import {
  addProject,
  createClimb,
  createPrivateStateClient,
  deleteClimb,
  listClimbs,
  listProjects,
  PrivateStateError,
  removeProject,
  type PrivateStateErrorCode,
  type UserClimbWithRoute,
  type UserProjectWithRoute,
} from "@/lib/private-state";

/**
 * Private-state smoke page — verification-only.
 *
 * Round-trips create → read → delete for one climb and one project against a
 * real Strapi route, exercising the full F-02 contract end-to-end:
 *   middleware auth gate → createPrivateStateClient → RLS-protected Supabase
 *   write → hydrated read joined against `@/lib/catalog`.
 *
 * This page is intentionally NOT linked from public navigation. Discovery is
 * by URL only. To prevent any signed-in user who stumbles onto it in a
 * deployed environment from polluting their own real climb log (S-04 / S-06
 * surface these rows in the user-visible UI), every Supabase read or write
 * is gated by the `SMOKE_WRITES_ENABLED=true` server env flag. The default
 * (flag unset) is fail-closed: the page renders its diagnostic shell and
 * performs zero I/O.
 */

const url = new URL(Astro.request.url);
const cleanup = url.searchParams.get("cleanup") === "1";

// `Astro.locals.user` is guaranteed non-null here because `/private-state-smoke`
// is in `PROTECTED_ROUTES` (see `src/middleware.ts`). The middleware redirect
// is the first line of defense; the `createPrivateStateClient` call below is
// the second.
const user = Astro.locals.user;

// `climbed_on` is a Postgres `date`; the catalog cache is server-only and we
// only need today's UTC calendar date. A repo-wide `formatDate()` helper is
// listed in AGENTS.md but does not exist yet (see private-state README); use
// `toISOString().slice(0, 10)` inline for this verification-only page.
const todayUtc = new Date().toISOString().slice(0, 10);

type DiagnosticKind = "missing_config" | "disabled" | "no_routes" | "error";

interface Diagnostic {
  kind: DiagnosticKind;
  message: string;
  detail?: string;
}

interface SmokeRouteSummary {
  id: string;
  name: string;
  grade: string;
  cragName: string;
}

interface CleanupResult {
  climbs: number;
  projects: number;
}

interface RoundtripResult {
  smokeRoute: SmokeRouteSummary;
  duplicateProjectTolerated: boolean;
  insertedClimb: { id: string; climbedOn: string } | null;
  insertedProject: { id: string; createdAt: string } | null;
  climbCount: number;
  projectCount: number;
}

let diagnostic: Diagnostic | null = null;
let roundtrip: RoundtripResult | null = null;
let cleanupResult: CleanupResult | null = null;
let hydratedClimbsPreview: UserClimbWithRoute[] = [];
let hydratedProjectsPreview: UserProjectWithRoute[] = [];
const writesEnabled = SMOKE_WRITES_ENABLED === "true";

function formatPrivateStateError(err: PrivateStateError): Diagnostic {
  const code: PrivateStateErrorCode = err.code;
  const offendingRouteId = typeof err.context.routeId === "string" ? err.context.routeId : undefined;
  switch (code) {
    case "unauthenticated":
      return {
        kind: "error",
        message: "Brak uwierzytelnionego użytkownika. Zaloguj się, aby uruchomić test.",
        detail: err.message,
      };
    case "missing_config":
      // Reuses the same Polish vocabulary as `configStatuses` — the page also
      // renders the missing-config diagnostic separately above this branch.
      return {
        kind: "missing_config",
        message: "Brakuje konfiguracji Supabase lub Strapi — sprawdź sekcję diagnostyki powyżej.",
        detail: err.message,
      };
    case "unknown_route":
      return {
        kind: "error",
        message: offendingRouteId
          ? `Strapi nie zwrócił żadnej drogi pod tym documentId: ${offendingRouteId}.`
          : "Strapi nie zwrócił żadnej drogi pod podanym documentId.",
        detail: err.message,
      };
    case "duplicate_project":
      return {
        kind: "error",
        message: "Projekt już istnieje dla tego użytkownika i tej drogi.",
        detail: err.message,
      };
    case "not_found":
      return {
        kind: "error",
        message: "Wiersz nie został znaleziony (lub należy do innego użytkownika).",
        detail: err.message,
      };
    case "upstream_error":
    default:
      return {
        kind: "error",
        message: "Nieoczekiwany błąd po stronie Supabase lub Strapi.",
        detail: err.message,
      };
  }
}

function formatUnknownError(err: unknown): Diagnostic {
  return {
    kind: "error",
    message: "Wystąpił nieoczekiwany błąd podczas testu private-state.",
    detail: err instanceof Error ? err.message : String(err),
  };
}

// Map the smoke target's crag to a display name. Falls back to the route's
// `cragSlug`, then to a literal "—" so the page never throws on a hydration
// miss (orphan-tolerance applies to read paths in general; smoke is no
// different).
function describeSmokeRoute(route: CatalogRoute, cragsById: Map<string, CatalogCrag>): SmokeRouteSummary {
  const cragFromCatalog = route.cragId ? cragsById.get(route.cragId) : undefined;
  const cragName = cragFromCatalog?.name ?? route.cragSlug ?? "—";
  return { id: route.id, name: route.name, grade: route.grade, cragName };
}

// All page logic is wrapped so any uncaught throw becomes a rendered Polish
// diagnostic — the smoke page itself never escapes to a 500.
try {
  // Step 1 — write-gate: if disabled, render the disabled diagnostic and
  // perform zero Supabase or Strapi reads / writes. This applies to both the
  // default landing render AND `?cleanup=1` so the gate is fail-closed end
  // to end.
  if (!writesEnabled) {
    diagnostic = {
      kind: "disabled",
      message:
        "Smoke jest wyłączony w tym środowisku — ustaw SMOKE_WRITES_ENABLED=true w .dev.vars, aby uruchomić test.",
    };
  } else {
    // Step 2 — missing-config diagnostic (same shape as `/catalog-smoke/regions`).
    const missing = configStatuses.filter((s) => !s.configured);
    if (missing.length > 0) {
      diagnostic = {
        kind: "missing_config",
        message: missing.map((s) => s.message).join(" "),
      };
    } else if (!user) {
      // Defensive — middleware should have redirected. If it did not, surface
      // a Polish diagnostic instead of crashing on `createPrivateStateClient`.
      diagnostic = {
        kind: "error",
        message: "Brak uwierzytelnionego użytkownika. Zaloguj się, aby uruchomić test.",
      };
    } else {
      // Step 3 — build the request-scoped private-state client. Throws
      // PrivateStateError on unauthenticated / missing_config; both surface
      // through the catch block as a rendered diagnostic.
      const client = createPrivateStateClient(Astro.request.headers, Astro.cookies, user);

      if (cleanup) {
        // CLEANUP PATH: enumerate every row owned by the current user — with
        // `includeOrphans: true` so orphan rows (route_id no longer in the
        // catalog) are not silently skipped — and delete them one by one.
        // Scoped to `client.userId`; RLS prevents collateral.
        const [allClimbs, allProjects] = await Promise.all([
          listClimbs(client, { includeOrphans: true }),
          listProjects(client, { includeOrphans: true }),
        ]);
        let climbsDeleted = 0;
        let projectsDeleted = 0;
        for (const climb of allClimbs) {
          await deleteClimb(client, climb.id);
          climbsDeleted += 1;
        }
        for (const project of allProjects) {
          await removeProject(client, project.id);
          projectsDeleted += 1;
        }
        cleanupResult = { climbs: climbsDeleted, projects: projectsDeleted };
      } else {
        // ROUND-TRIP PATH: pick a real Strapi route, write a climb + project,
        // read them back hydrated. listRoutes / listCrags share the F-01
        // cache so this is one resource each.
        const [routes, crags] = await Promise.all([listRoutes(), listCrags()]);

        if (routes.length === 0) {
          diagnostic = {
            kind: "no_routes",
            message:
              "Strapi nie zwrócił żadnych opublikowanych dróg — opublikuj co najmniej jedną drogę, aby uruchomić test.",
          };
        } else {
          const smokeRoute = routes[0];
          const cragsById = new Map<string, CatalogCrag>(crags.map((c) => [c.id, c] as const));
          const smokeRouteSummary = describeSmokeRoute(smokeRoute, cragsById);

          let insertedClimb: { id: string; climbedOn: string } | null = null;
          let insertedProject: { id: string; createdAt: string } | null = null;
          let duplicateProjectTolerated = false;

          const climb = await createClimb(client, { routeId: smokeRoute.id, climbedOn: todayUtc });
          insertedClimb = { id: climb.id, climbedOn: climb.climbedOn };

          try {
            const project = await addProject(client, { routeId: smokeRoute.id });
            insertedProject = { id: project.id, createdAt: project.createdAt };
          } catch (err) {
            // The operator may already have this route on their projects list
            // from a prior smoke run — the existing row still proves the
            // round-trip. Re-throw any other PrivateStateError code.
            if (err instanceof PrivateStateError && err.code === "duplicate_project") {
              duplicateProjectTolerated = true;
            } else {
              throw err;
            }
          }

          const [hydratedClimbs, hydratedProjects] = await Promise.all([listClimbs(client), listProjects(client)]);

          roundtrip = {
            smokeRoute: smokeRouteSummary,
            duplicateProjectTolerated,
            insertedClimb,
            insertedProject,
            climbCount: hydratedClimbs.length,
            projectCount: hydratedProjects.length,
          };

          hydratedClimbsPreview = hydratedClimbs.slice(0, 5);
          hydratedProjectsPreview = hydratedProjects.slice(0, 5);
        }
      }
    }
  }
} catch (err) {
  if (err instanceof PrivateStateError) {
    diagnostic = formatPrivateStateError(err);
  } else {
    diagnostic = formatUnknownError(err);
  }
}
---

<Layout title="Private-state smoke">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8 border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold tracking-wider text-amber-700 uppercase">Verification-only</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">Private-state smoke</h1>
      <p class="mt-3 text-sm text-slate-600">
        Test end-to-end kontraktu F-02: middleware auth → <code>createPrivateStateClient</code> → Supabase z RLS → hydratacja
        względem katalogu Strapi. Strona nie jest podłączona do publicznej nawigacji.
      </p>
      <p class="mt-3 text-xs text-slate-500">
        Write-gate:
        {
          writesEnabled ? (
            <span class="font-semibold text-emerald-700">enabled (SMOKE_WRITES_ENABLED=true)</span>
          ) : (
            <span class="font-semibold text-amber-700">disabled (default)</span>
          )
        }
      </p>
      {
        user && (
          <p class="mt-1 text-xs text-slate-500">
            Zalogowany jako: <code>{user.email ?? user.id}</code>
          </p>
        )
      }
    </header>

    {
      diagnostic && (
        <section
          class:list={[
            "rounded-md border p-4 text-sm",
            diagnostic.kind === "missing_config" || diagnostic.kind === "disabled" || diagnostic.kind === "no_routes"
              ? "border-amber-300 bg-amber-50 text-amber-900"
              : "border-red-300 bg-red-50 text-red-900",
          ]}
          role="alert"
        >
          <p class="font-semibold">
            {diagnostic.kind === "missing_config" && "Brak konfiguracji"}
            {diagnostic.kind === "disabled" && "Smoke wyłączony w tym środowisku"}
            {diagnostic.kind === "no_routes" && "Brak opublikowanych dróg"}
            {diagnostic.kind === "error" && "Błąd testu private-state"}
          </p>
          <p class="mt-1">{diagnostic.message}</p>
          {diagnostic.detail && <p class="mt-2 font-mono text-xs break-all opacity-80">{diagnostic.detail}</p>}
        </section>
      )
    }

    {
      cleanupResult && (
        <section class="mt-6 rounded-md border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-900">
          <p class="font-semibold">Cleanup zakończony</p>
          <p class="mt-1">
            Usunięto <strong>{cleanupResult.climbs}</strong> wpisów climbs oraz{" "}
            <strong>{cleanupResult.projects}</strong> projektów (włącznie z orphan rows).
          </p>
          <p class="mt-2">
            <a class="underline" href="/private-state-smoke">
              Uruchom round-trip ponownie
            </a>
          </p>
        </section>
      )
    }

    {
      roundtrip && (
        <>
          <section class="mt-6 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-800">
            <p class="font-semibold text-slate-900">Wybrana droga (Strapi)</p>
            <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
              <dt class="text-slate-500">documentId</dt>
              <dd class="font-mono text-xs break-all">{roundtrip.smokeRoute.id}</dd>
              <dt class="text-slate-500">Nazwa</dt>
              <dd class="font-medium">{roundtrip.smokeRoute.name}</dd>
              <dt class="text-slate-500">Wycena</dt>
              <dd>{roundtrip.smokeRoute.grade}</dd>
              <dt class="text-slate-500">Skała</dt>
              <dd>{roundtrip.smokeRoute.cragName}</dd>
            </dl>
          </section>

          <section class="mt-6 rounded-md border border-slate-200 p-4 text-sm">
            <p class="font-semibold text-slate-900">Wynik round-trip</p>
            <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
              <dt class="text-slate-500">Climb zapisany</dt>
              <dd>
                {roundtrip.insertedClimb ? (
                  <>
                    id <code class="text-xs">{roundtrip.insertedClimb.id}</code>, climbed_on{" "}
                    <code>{roundtrip.insertedClimb.climbedOn}</code>
                  </>
                ) : (
                  "—"
                )}
              </dd>
              <dt class="text-slate-500">Project dodany</dt>
              <dd>
                {roundtrip.insertedProject ? (
                  <>
                    id <code class="text-xs">{roundtrip.insertedProject.id}</code>, created_at{" "}
                    <code>{roundtrip.insertedProject.createdAt}</code>
                  </>
                ) : roundtrip.duplicateProjectTolerated ? (
                  <span class="text-amber-700">pominięto (duplikat — projekt już istniał, tolerowane)</span>
                ) : (
                  "—"
                )}
              </dd>
              <dt class="text-slate-500">Climbs (hydrated)</dt>
              <dd>
                <strong>{roundtrip.climbCount}</strong> wpisów po hydratacji względem katalogu
              </dd>
              <dt class="text-slate-500">Projects (hydrated)</dt>
              <dd>
                <strong>{roundtrip.projectCount}</strong> projektów po hydratacji względem katalogu
              </dd>
            </dl>
          </section>

          {hydratedClimbsPreview.length > 0 && (
            <section class="mt-6">
              <p class="text-sm font-semibold text-slate-900">Climbs — podgląd (max 5)</p>
              <ul class="mt-2 divide-y divide-slate-200 rounded-md border border-slate-200 text-sm">
                {hydratedClimbsPreview.map((c) => (
                  <li class="flex items-baseline justify-between gap-4 px-4 py-2">
                    <span>
                      <span class="font-medium">{c.route?.name ?? "(orphan)"}</span>
                      {c.route && <span class="ml-2 text-slate-500">{c.route.grade}</span>}
                    </span>
                    <code class="text-xs text-slate-500">{c.climbedOn}</code>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {hydratedProjectsPreview.length > 0 && (
            <section class="mt-6">
              <p class="text-sm font-semibold text-slate-900">Projects — podgląd (max 5)</p>
              <ul class="mt-2 divide-y divide-slate-200 rounded-md border border-slate-200 text-sm">
                {hydratedProjectsPreview.map((p) => (
                  <li class="flex items-baseline justify-between gap-4 px-4 py-2">
                    <span class="font-medium">{p.route?.name ?? "(orphan)"}</span>
                    <code class="text-xs text-slate-500">{p.createdAt}</code>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <section class="mt-8 rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
            <p class="font-semibold text-slate-900">Co to udowadnia</p>
            <p class="mt-1">
              Round-trip create → read → delete przeszedł dla zalogowanego użytkownika. RLS chroni wiersze przed innymi
              użytkownikami; hydratacja względem katalogu Strapi działa; <code>route_id</code> jest walidowane jako{" "}
              <code>documentId</code>; orphan rows są domyślnie odrzucane przy odczycie.
            </p>
            <p class="mt-3">
              <a
                class="inline-block rounded-md border border-red-300 bg-red-50 px-3 py-1.5 text-red-900 hover:bg-red-100"
                href="/private-state-smoke?cleanup=1"
              >
                Wyczyść moje climbs i projects (z orphan rows)
              </a>
            </p>
          </section>
        </>
      )
    }

    {
      !diagnostic && !roundtrip && !cleanupResult && (
        <section class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
          <p>Brak wyniku do wyświetlenia. Sprawdź konfigurację oraz logi.</p>
        </section>
      )
    }
  </main>
</Layout>
