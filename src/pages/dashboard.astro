---
import CatalogLayout from "@/layouts/CatalogLayout.astro";
import { getTranslations } from "@/i18n";

/**
 * `/dashboard` — protected lightweight entry point.
 *
 * The starter dashboard rendered a stand-alone purple/blue gradient
 * page that has nothing to do with the rest of the app. S-04 turns it
 * into a useful protected landing: the climber's email, a primary link
 * into `/historia`, and the existing POST sign-out button — all in the
 * shared CatalogLayout chrome so the navigation, breadcrumbs, and
 * footer match the catalog/history surfaces.
 *
 * Auth posture is unchanged: middleware (`src/middleware.ts`) gates
 * `/dashboard` via `PROTECTED_ROUTES`, so `Astro.locals.user` is
 * non-null below.
 *
 * Scope: this page deliberately stays tiny. Stats, projects, and
 * delete-climb actions are the next slices' (S-05 / S-06) territory.
 */

const { user } = Astro.locals;
const t = getTranslations();
---

<CatalogLayout
  title={t("dashboard.page_title")}
  breadcrumbs={[{ label: "SendLog", href: "/" }, { label: t("dashboard.heading") }]}
>
  <section class="py-2 sm:py-4">
    <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">{t("dashboard.heading")}</h1>
    <p class="mt-2 text-sm text-slate-600 sm:text-base">
      {t("dashboard.welcome")}, <span class="font-medium text-slate-900">{user?.email}</span>
    </p>

    <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a
        href="/historia"
        class="inline-flex items-center justify-center rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
      >
        {t("dashboard.history_link")}
      </a>

      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
        >
          {t("dashboard.signout")}
        </button>
      </form>
    </div>
  </section>
</CatalogLayout>
