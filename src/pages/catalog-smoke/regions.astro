---
import Layout from "@/layouts/Layout.astro";
import { CatalogError, listRegions, type CatalogRegion } from "@/lib/catalog";

/**
 * Catalog smoke page — verification-only.
 *
 * Renders published Strapi regions through the server-only catalog module
 * (Phase 3 of catalog-content-contract). This route is intentionally NOT
 * surfaced from public navigation; it exists to prove the end-to-end Strapi
 * read path works in local dev and on the deployed Worker.
 *
 * Cache behavior matches `@/lib/catalog/cache`:
 *  - Localhost Strapi → cache automatically bypassed.
 *  - Query string `?bypass-cache=1` (or `=true`) → forces `bypassCache: true`
 *    so admins can verify edit visibility against production Strapi without
 *    waiting for the 1-hour TTL.
 *  - Otherwise reads are cached for 1 hour.
 */

const url = new URL(Astro.request.url);
const bypassParam = url.searchParams.get("bypass-cache");
const bypassCache = bypassParam === "1" || bypassParam === "true";

let regions: CatalogRegion[] = [];
let diagnostic: { kind: "missing_config" | "error"; message: string; detail?: string } | null = null;

try {
  regions = await listRegions({ bypassCache });
} catch (err) {
  if (err instanceof CatalogError) {
    if (err.code === "missing_config") {
      diagnostic = {
        kind: "missing_config",
        message:
          "Strapi nie jest skonfigurowany. Ustaw STRAPI_API_URL i STRAPI_API_TOKEN w .dev.vars (lokalnie) lub jako sekrety Workera (produkcja).",
      };
    } else {
      diagnostic = {
        kind: "error",
        message: "Nie udało się pobrać regionów ze Strapi.",
        detail: `${err.code}: ${err.message}`,
      };
    }
  } else {
    diagnostic = {
      kind: "error",
      message: "Wystąpił nieoczekiwany błąd podczas odczytu katalogu.",
      detail: err instanceof Error ? err.message : String(err),
    };
  }
}
---

<Layout title="Catalog smoke — regions">
  <main class="mx-auto max-w-3xl px-4 py-12">
    <header class="mb-8 border-b border-slate-200 pb-6">
      <p class="text-xs font-semibold tracking-wider text-amber-700 uppercase">Verification-only</p>
      <h1 class="mt-2 text-3xl font-bold text-slate-900">Catalog smoke — regions</h1>
      <p class="mt-3 text-sm text-slate-600">
        Server-side smoke test of the Strapi catalog read contract. This page is not part of public navigation and is
        intended for manual verification of the F-01 read path.
      </p>
      <p class="mt-3 text-xs text-slate-500">
        Cache:
        {
          bypassCache ? (
            <span class="font-semibold text-amber-700">bypassed (?bypass-cache=1)</span>
          ) : (
            <>
              <span class="font-semibold text-slate-700">enabled</span>
              <span> — append </span>
              <a class="underline" href="?bypass-cache=1">
                ?bypass-cache=1
              </a>
              <span> to force a fresh read.</span>
            </>
          )
        }
      </p>
    </header>

    {
      diagnostic && (
        <section
          class:list={[
            "rounded-md border p-4 text-sm",
            diagnostic.kind === "missing_config"
              ? "border-amber-300 bg-amber-50 text-amber-900"
              : "border-red-300 bg-red-50 text-red-900",
          ]}
          role="alert"
        >
          <p class="font-semibold">
            {diagnostic.kind === "missing_config" ? "Brak konfiguracji Strapi" : "Błąd odczytu katalogu"}
          </p>
          <p class="mt-1">{diagnostic.message}</p>
          {diagnostic.detail && <p class="mt-2 font-mono text-xs break-all opacity-80">{diagnostic.detail}</p>}
        </section>
      )
    }

    {
      !diagnostic && regions.length === 0 && (
        <section class="rounded-md border border-slate-200 bg-slate-50 p-4 text-sm text-slate-700">
          <p class="font-semibold">Brak opublikowanych regionów.</p>
          <p class="mt-1">
            Strapi zwrócił pustą listę. Utwórz i opublikuj region w panelu Strapi, a następnie odśwież tę stronę (z
            opcją <code class="rounded bg-slate-200 px-1 py-0.5">?bypass-cache=1</code> jeśli korzystasz z produkcyjnego
            Strapi).
          </p>
        </section>
      )
    }

    {
      !diagnostic && regions.length > 0 && (
        <section>
          <p class="mb-3 text-sm text-slate-600">
            Znaleziono <strong>{regions.length}</strong> opublikowanych regionów (locale: <code>pl</code>).
          </p>
          <ul class="divide-y divide-slate-200 rounded-md border border-slate-200">
            {regions.map((region) => (
              <li class="flex items-baseline justify-between gap-4 px-4 py-3">
                <span class="font-medium text-slate-900">{region.name}</span>
                <code class="text-xs text-slate-500">{region.slug}</code>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Layout>
