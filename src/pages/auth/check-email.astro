---
import Layout from "@/layouts/Layout.astro";
import { buildSignInRedirect, sanitizeNextPath } from "@/lib/auth";
import { getTranslations } from "@/i18n";

const t = getTranslations();

// Generic copy by design. The submitted email address is intentionally not
// rendered or carried in the URL — see plan Phase 2 §4 "Check-email page".
const next = sanitizeNextPath(Astro.url.searchParams.get("next"));
const retryHref = buildSignInRedirect({ next });
---

<Layout title={t("auth.check_email.page_title")}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <div class="mb-4 text-5xl">📧</div>
      <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        {t("auth.check_email.heading")}
      </h1>
      <p class="mb-6 text-blue-100/80">
        {t("auth.check_email.body")}
      </p>
      <a href={retryHref} class="text-sm text-purple-300 hover:underline">
        {t("auth.check_email.retry_link")}
      </a>
    </div>
  </div>
</Layout>
