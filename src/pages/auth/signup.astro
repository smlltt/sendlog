---
import { buildSignInRedirect } from "@/lib/auth";

// SendLog's auth surface is unified on `/auth/signin` (passwordless magic
// link). First-time visitors are auto-created by `signInWithOtp`, so there
// is no separate password-signup page. Preserve any `next` hint through the
// redirect so a deep-linked protected-route intent is not lost.
const nextRaw = Astro.url.searchParams.get("next");
return Astro.redirect(buildSignInRedirect({ next: nextRaw }), 307);
---
