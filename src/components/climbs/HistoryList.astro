---
import HistoryClimbCard from "@/components/climbs/HistoryClimbCard";
import type { HistoryClimbItem } from "@/components/climbs/types";

/**
 * <HistoryList> — server-render wrapper that hands the climb history to the
 * `<HistoryClimbCard>` React island for per-row delete interaction (S-05).
 *
 * Boundary: this component never issues its own private-state read and
 * intentionally does NOT import `@/lib/private-state` or `@/lib/catalog`.
 * The calling page (`src/pages/historia.astro`) hydrates climbs, joins crag
 * names, and projects each row into the primitive `HistoryClimbItem` DTO;
 * those primitives cross into the island as props.
 *
 * Why an island now: S-05 adds inline two-step delete, in-flight `Pending`
 * feedback, local row removal, and Polish success / neutral stale-row copy
 * — all client-side state. The island owns the full list so deleting the
 * last row falls through to the same Polish empty-state without a refresh.
 * The card layout (single column, `[max-content_1fr]` two-column `<dl>` on
 * `sm:`+) lives inside the island so the markup stays in one place.
 *
 * The progress registry's "Personal history initial load" row points at
 * `src/pages/historia.astro`, not here — the initial paint is the page's
 * concern. The >2 s delete mutation's `Pending` primitive lives in the
 * island.
 */

interface Props {
  climbs: HistoryClimbItem[];
}

const { climbs } = Astro.props;
---

<HistoryClimbCard climbs={climbs} client:load />
