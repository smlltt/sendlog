---
import type { CatalogPhoto } from "@/lib/catalog";
import { getTranslations, format } from "@/i18n";

interface Props {
  photos: CatalogPhoto[];
  cragName: string;
}

const { photos, cragName } = Astro.props;
const t = getTranslations();
const hero = photos.at(0);
const showStrip = photos.length > 1;
const galleryName = `crag-photos-${photos.map((photo) => photo.url).join("-").length}`;

function hasIntrinsicSize(photo: CatalogPhoto): photo is CatalogPhoto & { width: number; height: number } {
  return typeof photo.width === "number" && typeof photo.height === "number";
}
---

{
  hero && (
    <figure class="crag-photo-gallery mt-6">
      {photos.map((photo, idx) => (
        <>
          <input
            id={`${galleryName}-${idx}`}
            type="radio"
            name={galleryName}
            class="sr-only"
            checked={idx === 0}
            aria-label={format(t("catalog.photos.aria_photo_n_of_m"), { n: idx + 1, m: photos.length })}
          />
          <a href={photo.url} target="_blank" rel="noopener" class="hero-link overflow-hidden rounded-lg bg-slate-100">
            <img
              src={photo.url}
              alt={photo.alt ?? cragName}
              fetchpriority={idx === 0 ? "high" : undefined}
              loading={idx === 0 ? undefined : "lazy"}
              decoding="async"
              width={hasIntrinsicSize(photo) ? photo.width : undefined}
              height={hasIntrinsicSize(photo) ? photo.height : undefined}
              class="mx-auto max-h-[480px] w-full object-contain"
            />
          </a>
        </>
      ))}
      {showStrip && (
        <ul class="mt-3 flex gap-2 overflow-x-auto pb-1">
          {photos.map((photo, idx) => (
            <li class="flex-none">
              <label
                for={`${galleryName}-${idx}`}
                class="block cursor-pointer overflow-hidden rounded border border-slate-200 transition-colors hover:border-slate-400"
              >
                <span class="sr-only">
                  {format(t("catalog.photos.show_photo_n_of_m"), { n: idx + 1, m: photos.length })}
                </span>
                <img
                  src={photo.url}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width={hasIntrinsicSize(photo) ? photo.width : undefined}
                  height={hasIntrinsicSize(photo) ? photo.height : undefined}
                  class="h-20 w-[120px] object-cover"
                />
              </label>
            </li>
          ))}
        </ul>
      )}
    </figure>
  )
}

<style>
  :global(.crag-photo-gallery > input:not(:checked) + .hero-link) {
    display: none;
  }

  :global(.crag-photo-gallery > input:checked + .hero-link) {
    display: block;
  }
</style>
