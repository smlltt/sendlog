---
import { CatalogError } from "@/lib/catalog";
import { getTranslations } from "@/i18n";

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const t = getTranslations();

interface Diagnostic {
  kind: "missing_config" | "catalog_error" | "unknown_error";
  title: string;
  message: string;
  detail?: string;
}

let diagnostic: Diagnostic;

if (error instanceof CatalogError) {
  if (error.code === "missing_config") {
    diagnostic = {
      kind: "missing_config",
      title: t("catalog.errors.missing_config_title"),
      message: t("catalog.errors.missing_config_message"),
    };
  } else {
    diagnostic = {
      kind: "catalog_error",
      title: t("catalog.errors.catalog_error_title"),
      message: t("catalog.errors.catalog_error_message"),
      detail: `${error.code}: ${error.message}`,
    };
  }
} else {
  diagnostic = {
    kind: "unknown_error",
    title: t("catalog.errors.unknown_error_title"),
    message: t("catalog.errors.unknown_error_message"),
    detail: error instanceof Error ? error.message : String(error),
  };
}
---

<section
  class:list={[
    "rounded-md border p-4 text-sm",
    diagnostic.kind === "missing_config"
      ? "border-amber-300 bg-amber-50 text-amber-900"
      : "border-red-300 bg-red-50 text-red-900",
  ]}
  role="alert"
>
  <p class="font-semibold">{diagnostic.title}</p>
  <p class="mt-1">{diagnostic.message}</p>
  {diagnostic.detail && <p class="mt-2 font-mono text-xs break-all opacity-80">{diagnostic.detail}</p>}
</section>
