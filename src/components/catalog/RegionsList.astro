---
import type { CatalogRegion } from "@/lib/catalog";

interface Props {
  regions: CatalogRegion[];
}

const { regions } = Astro.props;
---

{
  regions.length === 0 ? (
    <p class="rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">Brak opublikowanych rejonów.</p>
  ) : (
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
      {regions.map((region) => (
        <li>
          <a
            href={`/regiony/${region.slug}`}
            class="block rounded-md border border-slate-200 bg-white px-4 py-3 text-base font-medium text-slate-900 transition-colors hover:border-slate-400 hover:bg-slate-50"
          >
            {region.name}
          </a>
        </li>
      ))}
    </ul>
  )
}
