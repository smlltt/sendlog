---
import type { CatalogRoute } from "@/lib/catalog";
import { getTranslations } from "@/i18n";
import RouteClimbAction from "@/components/climbs/RouteClimbAction";
import ProjectAction from "@/components/projects/ProjectAction";
import type { RouteClimbSummary } from "@/components/climbs/types";

interface Props {
  routes: CatalogRoute[];
  /**
   * Per-route, per-user climb summaries computed server-side by the crag
   * page from `listClimbs(client)`. Only passed when `isSignedIn` is
   * true; signed-out renders leave this unset.
   */
  climbSummariesByRouteId?: Map<string, RouteClimbSummary>;
  /**
   * Per-route project membership (routeId → project row id) computed
   * server-side by the crag page from `listProjects(client)`. A present
   * entry means the route is on the user's projects list; the value is the
   * project row id the toggle's `DELETE` needs. Only passed when signed in.
   */
  projectMembershipByRouteId?: Map<string, string>;
  /**
   * Whether a `RouteClimbAction` island should render in each row. Kept
   * as a separate flag from `climbSummariesByRouteId` so the table can
   * still render the action column for a signed-in user with zero
   * existing climbs (every map lookup returns `undefined`).
   */
  isSignedIn?: boolean;
  /**
   * Today's UTC `YYYY-MM-DD` date, computed server-side via the repo's
   * `formatDate()` helper. Passed in so the React form's default value
   * matches the server-rendered HTML during hydration and avoids
   * timezone drift across server / client.
   */
  defaultClimbedOn?: string;
}

const {
  routes,
  climbSummariesByRouteId,
  projectMembershipByRouteId,
  isSignedIn = false,
  defaultClimbedOn,
} = Astro.props;
const t = getTranslations();

const CELL_BASE_CLASSES =
  "block sm:table-cell px-3 py-1 sm:py-2 before:content-[attr(data-label)] before:mr-2 before:font-medium before:text-slate-500 sm:before:content-none";

const showActions = isSignedIn && typeof defaultClimbedOn === "string";

function summaryFor(routeId: string): RouteClimbSummary {
  return climbSummariesByRouteId?.get(routeId) ?? { count: 0, latestClimbedOn: null };
}
---

{
  routes.length === 0 ? (
    <p class="rounded-md border border-slate-200 bg-white p-4 text-sm text-slate-700">{t("catalog.routes.empty")}</p>
  ) : (
    <table class="w-full text-sm">
      <thead class="sr-only sm:not-sr-only">
        <tr>
          <th class="border-b border-slate-200 px-3 py-2 text-left font-medium text-slate-700">
            {t("catalog.routes.column_name")}
          </th>
          <th class="border-b border-slate-200 px-3 py-2 text-left font-medium text-slate-700">
            {t("catalog.routes.column_grade")}
          </th>
          <th class="border-b border-slate-200 px-3 py-2 text-left font-medium text-slate-700">
            {t("catalog.routes.column_type")}
          </th>
          <th class="border-b border-slate-200 px-3 py-2 text-left font-medium text-slate-700">
            {t("catalog.routes.column_year")}
          </th>
          {showActions && (
            <th class="border-b border-slate-200 px-3 py-2 text-left font-medium text-slate-700">
              {t("catalog.routes.column_log")}
            </th>
          )}
        </tr>
      </thead>
      <tbody>
        {routes.map((route) => (
          <tr class="mb-3 block rounded-md border border-slate-200 bg-white sm:mb-0 sm:table-row sm:rounded-none sm:border-0 sm:border-b sm:bg-transparent">
            <td
              data-label={t("catalog.routes.cell_name_label")}
              class:list={[CELL_BASE_CLASSES, "font-medium text-slate-900"]}
            >
              {route.name}
            </td>
            <td data-label={t("catalog.routes.cell_grade_label")} class:list={[CELL_BASE_CLASSES]}>
              {route.grade}
            </td>
            <td data-label={t("catalog.routes.cell_type_label")} class:list={[CELL_BASE_CLASSES]}>
              {route.type}
            </td>
            <td data-label={t("catalog.routes.cell_year_label")} class:list={[CELL_BASE_CLASSES]}>
              {route.yearSet ?? t("catalog.routes.year_missing")}
            </td>
            {showActions && (
              <td data-label={t("catalog.routes.cell_log_label")} class:list={[CELL_BASE_CLASSES]}>
                <div class="flex flex-col gap-2">
                  <RouteClimbAction
                    client:load
                    routeId={route.id}
                    initialSummary={summaryFor(route.id)}
                    defaultClimbedOn={defaultClimbedOn}
                  />
                  <ProjectAction
                    client:load
                    routeId={route.id}
                    initialProjectId={projectMembershipByRouteId?.get(route.id) ?? null}
                  />
                </div>
              </td>
            )}
          </tr>
        ))}
      </tbody>
    </table>
  )
}
