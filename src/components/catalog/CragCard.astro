---
import type { CatalogCrag } from "@/lib/catalog";

interface Props {
  crag: CatalogCrag;
  href: string;
}

const { crag, href } = Astro.props;
const thumbnail = crag.photos.at(0);
---

<a
  href={href}
  class="flex flex-col gap-3 rounded-md border border-slate-200 bg-white p-3 transition-colors hover:border-slate-400 hover:bg-slate-50 sm:flex-row sm:items-center sm:gap-4 sm:p-4"
>
  {
    thumbnail !== undefined && (
      <img
        src={thumbnail.url}
        alt={thumbnail.alt ?? crag.name}
        loading="lazy"
        decoding="async"
        width={thumbnail.width}
        height={thumbnail.height}
        class="h-24 w-24 flex-none rounded object-cover sm:h-[120px] sm:w-[120px]"
      />
    )
  }
  <div class="min-w-0 flex-1">
    <h3 class="text-base font-semibold text-slate-900 sm:text-lg">{crag.name}</h3>
    <p class="mt-1 text-xs text-slate-500 sm:text-sm">{crag.slug}</p>
  </div>
</a>
