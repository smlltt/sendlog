---
import Layout from "@/layouts/Layout.astro";
import CatalogHeader from "@/components/catalog/CatalogHeader.astro";
import CatalogFooter from "@/components/catalog/CatalogFooter.astro";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  breadcrumbs?: Breadcrumb[];
}

const { title, breadcrumbs } = Astro.props;
const { user } = Astro.locals;
---

<Layout title={title}>
  <div class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <CatalogHeader user={user} breadcrumbs={breadcrumbs} />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:py-12">
      <slot />
    </main>
    <CatalogFooter />
  </div>
</Layout>
